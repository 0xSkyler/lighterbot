# Lighter BTC scalper - environment file.
# Copy to .env (local) or /etc/lighter-scalper/lighter-scalper.env (server). NEVER commit the real file.
# This application trades LIVE on Lighter MAINNET with real funds. There is no paper or test mode.

# ---------------------------------------------------------------- safety gates
# Both must be set exactly as shown below or the service refuses to start.
#   LIVE_TRADING=true
#   I_UNDERSTAND_THIS_USES_REAL_FUNDS=YES
LIVE_TRADING=
I_UNDERSTAND_THIS_USES_REAL_FUNDS=

# ----------------------------------------------------------------- credentials
# Account index of the (sub-)account the bot trades. Use a dedicated sub-account:
# the bot treats ANY BTC position on this account as its own.
LIGHTER_ACCOUNT_INDEX=
# API key index registered for that account (4-254; 0-3 are reserved for Lighter's apps).
LIGHTER_API_KEY_INDEX=
# The API key's private key (hex). This is NOT your wallet key or seed phrase.
LIGHTER_API_PRIVATE_KEY=

# ---------------------------------------------------------------------- market
MARKET=BTC

# ---------------------------------------------------------------------- sizing
# Leverage is validated against what Lighter currently allows and confirmed on the
# exchange before any entry. It is never substituted silently.
LEVERAGE=25
# cross | isolated
MARGIN_MODE=cross
# fixed_margin: notional = MARGIN_PER_TRADE_USD * LEVERAGE.  fixed_notional: NOTIONAL_PER_TRADE_USD.
POSITION_MODE=fixed_margin
MARGIN_PER_TRADE_USD=10
NOTIONAL_PER_TRADE_USD=

# ----------------------------------------------------------------- profit exit
# GREEN = the whole position can be closed now for net realized P&L above this threshold.
# The larger of the two applies. At least one must be > 0.
MIN_PROFIT_USD=0.01
MIN_PROFIT_BPS=0
# Extra cushion subtracted from the estimated exit value before a trade counts as green.
SAFETY_BUFFER_BPS=0
# flat_first : once green is detected, close within MAX_NORMAL_EXIT_SLIPPAGE_BPS and keep closing.
# profit_only: the exit can only fill at a price that is still profitable; a miss returns to monitoring.
PROFIT_EXIT_MODE=flat_first
EXIT_ON_SIGNAL_REVERSAL=false

# ----------------------------------------------------------------- entry order
# maker: the entry rests on our own side of the book (post-only). It never pays the spread and
#        Lighter applies no delay to it, but it only fills if someone trades against it.
# taker: the entry crosses the spread with LIMIT+IOC inside MAX_ENTRY_SLIPPAGE_BPS. Certain fill,
#        but it pays the spread and (Standard accounts) lands about 300 ms after the signal.
ENTRY_MODE=maker
# Maker mode: cancel an entry that has not filled after this long.
MAKER_REST_MS=1500
# Maker mode: step this many ticks in front of the best bid/ask when the spread has room
# (0 = join the queue at the best price). The order never crosses the spread.
MAKER_IMPROVE_TICKS=1
# Maker mode: cancel the entry if the market moves away from it by more than this (0 = off).
MAKER_MAX_DRIFT_BPS=0.5

# -------------------------------------------------------------------- slippage
# MAX_ENTRY_SLIPPAGE_BPS is only used when ENTRY_MODE=taker.
MAX_ENTRY_SLIPPAGE_BPS=1
MAX_NORMAL_EXIT_SLIPPAGE_BPS=2
MAX_EMERGENCY_EXIT_SLIPPAGE_BPS=30

# ------------------------------------------------------------- hard protection
# Catastrophic protection, not a profit target. At least one must be > 0.
MAX_ADVERSE_MOVE_BPS=10
MAX_LOSS_USD=0.50
# A scalp that is neither green nor stopped is flattened after this long.
MAX_HOLD_MS=5000
# No entries on data older than this; with a position open it triggers recovery.
MARKET_DATA_STALE_MS=1000

# ---------------------------------------------------------------- entry signal
MAX_SPREAD_BPS=1.0
MAX_VOLATILITY_BPS=15
ENTRY_SCORE_THRESHOLD=0.60
BOOK_IMBALANCE_WEIGHT=1.0
TRADE_FLOW_WEIGHT=1.5
MICRO_MOMENTUM_WEIGHT=1.5
BBO_MOMENTUM_WEIGHT=1.0
MICROPRICE_WEIGHT=1.0
VOLUME_ACCEL_WEIGHT=0.5
DEPTH_CHANGE_WEIGHT=0.5
BOOK_DEPTH_LEVELS=10
MOMENTUM_SCALE_BPS=2
# Upper bound on entries per minute. The market decides the actual frequency.
MAX_ENTRIES_PER_MINUTE=20

# --------------------------------------------------------- account / recovery
# What to do with a BTC position that already exists at startup or appears unexpectedly:
#   manage  - adopt it and run the normal exit rules (green / hard loss / MAX_HOLD_MS)
#   flatten - close it immediately
#   halt    - leave it untouched and do not trade
EXISTING_POSITION_ACTION=manage
# On SIGTERM/SIGINT (systemctl stop/restart, reboot): flatten | keep
SHUTDOWN_POSITION_ACTION=flatten
# Cancel resting BTC orders that this bot did not create (otherwise they block entries).
CANCEL_FOREIGN_ORDERS=false
# Optional overrides. Leave empty to use what the exchange reports for the account tier.
TAKER_FEE_BPS=
RATE_LIMIT_PER_MINUTE=

# --------------------------------------------------------------- control panel
# Read by `lighter-scalper ui`. On a server install these are set in the panel's systemd unit.
# The panel is plain HTTP and can start live trading: keep it on 127.0.0.1.
#UI_HOST=127.0.0.1
#UI_PORT=8787

# --------------------------------------------------------------------- runtime
LOG_LEVEL=INFO
# DATA_DIR and LOG_DIR are set by the systemd unit on a server install.
#DATA_DIR=data
#LOG_DIR=logs
