// polkit rule installed to /etc/polkit-1/rules.d/ by deploy/install.sh.
//
// Lets the control panel (which runs as the unprivileged user "scalper") start, stop and
// restart exactly one unit: lighter-scalper.service. It grants nothing else.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "lighter-scalper.service" &&
        subject.user == "scalper") {
        var verb = action.lookup("verb");
        if (verb == "start" || verb == "stop" || verb == "restart") {
            return polkit.Result.YES;
        }
    }
});
